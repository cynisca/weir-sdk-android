<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The demo flow primes notifications; declare the runtime permission so
         the POST_NOTIFICATIONS request actually shows a dialog on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Weir's event ingest flushes over the network when a host wires an
         ingest endpoint (demo/E2E: the hermetic box over http://10.0.2.2).
         The :weir library declares no INTERNET permission of its own — it only
         opens sockets when the host opts into ingest — so the host declares it.
         Without this, socket() fails with EPERM before any flush leaves. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:label="Weir Demo"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeirDemo">

        <activity
            android:name="studio.aldric.weir.demo.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- WeirFlowActivity is merged in from the :weir library manifest. -->
    </application>
</manifest>
