<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      WeirFlowActivity — the SDK's native Compose presentation host. Declared
      here so it merges into any consuming app's manifest automatically; the app
      does not re-declare it.

      - not exported: only Weir.present launches it.
      - configChanges: recreation would drop the in-process presentation
        registry entry and strand the caller's completion.
      - a platform NoActionBar theme (no AppCompat dependency); the real
        background is set programmatically per-flow in onCreate (no white flash).
    -->
    <application>
        <activity
            android:name="studio.aldric.weir.WeirFlowActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|density"
            android:theme="@android:style/Theme.Material.NoActionBar" />
    </application>
</manifest>
